{
  "name": "gakumasu-server-event-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "docker:dev": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:lint": "docker compose run --rm --no-deps web npm run lint",
    "docker:test": "docker compose run --rm --no-deps web npm run test",
    "docker:build": "docker compose run --rm --no-deps web npm run build",
    "backend:start": "docker compose up -d backend",
    "backend:stop": "docker compose stop backend",
    "backend:status": "docker compose exec backend supabase status",
    "backend:reset": "docker compose exec backend supabase db reset",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.52.0",
    "browser-image-compression": "^2.0.2",
    "heic2any": "^0.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
